APP_NAME=permission-aware-rag
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Application database connection.
# The backend must use the restricted role.
DATABASE_URL=postgresql+asyncpg://rag_app:change-me-app@localhost:5433/rag_dev
MIGRATION_DATABASE_URL=postgresql+psycopg://rag_migration_admin:change-me-migration@localhost:5433/rag_dev
REDIS_URL=redis://:change-me@localhost:6380/0

JWT_SECRET_KEY=replace-with-a-development-only-secret-at-least-32-characters

# Browser-safe public configuration only.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
